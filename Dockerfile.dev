FROM golang:1.24.4-bookworm

ARG GOPLS_VERSION=v0.18.1
ARG DELVE_VERSION=v1.24.2
ARG AIR_VERSION=v1.61.7
ARG MIGRATE_VERSION=v4.18.3

RUN apt-get update && apt-get install -y \
    bash \
    ca-certificates \
    curl \
    git \
    gh \
    gnupg \
    jq \
    make \
    postgresql-client \
    protobuf-compiler \
    ripgrep \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Modern Docker CLI + `docker compose`
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# Go dev tools
RUN go install golang.org/x/tools/gopls@${GOPLS_VERSION} \
    && go install github.com/go-delve/delve/cmd/dlv@${DELVE_VERSION} \
    && go install github.com/air-verse/air@${AIR_VERSION}

# Database migration CLI
RUN go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@${MIGRATE_VERSION}

RUN curl -fLo /root/.vim/autoload/plug.vim --create-dirs \
    https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim

ENV PATH="/go/bin:${PATH}"

WORKDIR /workspace
RUN echo 'export PS1="[build] \u@\h:\w\\$ "' >> /root/.bashrc
